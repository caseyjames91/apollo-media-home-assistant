<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.video.apollomedia" name="Apollo Media" version="0.9.99" provider-name="Apollo Media">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
  </requires>
  <extension point="xbmc.python.pluginsource" library="main.py">
    <provides>video</provides>
  </extension>
  <extension point="xbmc.service" library="service.py" start="login"/>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">A unified, local-first Kodi media browser</summary>
    <description lang="en_GB">Apollo provides Kodi-native movie and TV discovery, Apollo-owned progress, local media resolution, and remote stream playback.</description>
    <platform>all</platform>
    <license>MIT</license>
  </extension>
</addon>
