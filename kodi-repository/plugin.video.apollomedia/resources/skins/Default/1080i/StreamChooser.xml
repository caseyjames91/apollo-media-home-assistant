<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog">
    <defaultcontrol always="true">100</defaultcontrol>
    <coordinates>
        <system>1</system>
        <origin x="0" y="0"/>
    </coordinates>

    <controls>
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture>special://home/addons/plugin.video.apollomedia/resources/media/dialog_bg.png</texture>
        </control>

        <control type="image">
            <left>210</left>
            <top>125</top>
            <width>1500</width>
            <height>820</height>
            <texture>special://home/addons/plugin.video.apollomedia/resources/media/dialog_panel.png</texture>
        </control>

        <control type="label">
            <left>275</left>
            <top>165</top>
            <width>1360</width>
            <height>48</height>
            <font>font24_title</font>
            <label>Choose Remote Stream</label>
        </control>

        <control type="label">
            <left>275</left>
            <top>216</top>
            <width>1360</width>
            <height>34</height>
            <font>font10</font>
            <textcolor>FFAAAAAA</textcolor>
            <label>OK: Play    C: Stream options    Back: Close</label>
        </control>

        <control type="list" id="100">
            <left>275</left>
            <top>275</top>
            <width>1360</width>
            <height>610</height>
            <onup>100</onup>
            <ondown>100</ondown>

            <itemlayout width="1360" height="82">
                <control type="image">
                    <left>0</left>
                    <top>0</top>
                    <width>1360</width>
                    <height>78</height>
                    <texture>special://home/addons/plugin.video.apollomedia/resources/media/row_normal.png</texture>
                </control>

                <control type="label">
                    <left>18</left>
                    <top>8</top>
                    <width>1180</width>
                    <height>36</height>
                    <font>font13</font>
                    <label>$INFO[ListItem.Label]</label>
                </control>

                <control type="label">
                    <left>18</left>
                    <top>44</top>
                    <width>1180</width>
                    <height>26</height>
                    <font>font10</font>
                    <textcolor>FFAAAAAA</textcolor>
                    <label>$INFO[ListItem.Property(Apollo.Provider)]$INFO[ListItem.Property(Apollo.FlagReason),  •  ]</label>
                </control>

                <control type="image">
                    <left>1275</left>
                    <top>16</top>
                    <width>46</width>
                    <height>46</height>
                    <texture>special://home/addons/plugin.video.apollomedia/resources/media/flagged.png</texture>
                    <visible>String.IsEqual(ListItem.Property(Apollo.Flagged),true)</visible>
                </control>
            </itemlayout>

            <focusedlayout width="1360" height="82">
                <control type="image">
                    <left>0</left>
                    <top>0</top>
                    <width>1360</width>
                    <height>78</height>
                    <texture>special://home/addons/plugin.video.apollomedia/resources/media/row_focus.png</texture>
                </control>

                <control type="label">
                    <left>18</left>
                    <top>8</top>
                    <width>1180</width>
                    <height>36</height>
                    <font>font13</font>
                    <label>$INFO[ListItem.Label]</label>
                </control>

                <control type="label">
                    <left>18</left>
                    <top>44</top>
                    <width>1180</width>
                    <height>26</height>
                    <font>font10</font>
                    <textcolor>FFFFFFFF</textcolor>
                    <label>$INFO[ListItem.Property(Apollo.Provider)]$INFO[ListItem.Property(Apollo.FlagReason),  •  ]</label>
                </control>

                <control type="image">
                    <left>1275</left>
                    <top>16</top>
                    <width>46</width>
                    <height>46</height>
                    <texture>special://home/addons/plugin.video.apollomedia/resources/media/flagged.png</texture>
                    <visible>String.IsEqual(ListItem.Property(Apollo.Flagged),true)</visible>
                </control>
            </focusedlayout>
        </control>
    </controls>
</window>
